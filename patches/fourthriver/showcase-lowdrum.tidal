d1
    $ hurry 0.5
    $ chunk 4 (hurry "<0.5 2>")
    $ almostNever (# accelerate "-2")
    $ n "{~ <2!2 ~> <2 1> ~ <2!3 2*2>}%8"
    # s "ttk" 
    # cps (140/60/4)
    # gain 1.2
    # distort 0.1
    # shape 0.3
    -- # nudge 0.24

d1 silence

d5
  -- $ every 12 (degradeBy 1)
  -- $ (~>) 0.04
  $ s "super808/2"
  # rate "{0.2 1 0.4 1}%5"
  # voicebus 0 (range 0 1.3 $ slow 3.4 $ sine)
  # shape 0.4
  # gain 1.2
  # lpfbus 1 (range 2500 1500 $ perlin)
  -- # nudge 0.24

d1
-- $ qt
$ echoWith 2 "0" (rev . hurry 2)
$ mask "{1 0 0 1 1 0 1 0 1 1 1}%16"
$ fast "1 1 <0.5 1 0.5> 1"
-- $ often (echoWith 4 "1%4" (|* gain 0.9) . (|* legato 0.9))
-- $ fast 0.5
-- $ n (slow 2 $ runmod 32 "{2 1}%5" "<10 [17 10]>")
-- |* n "{1 2}%3"
-- $ sometimes (chop "2 32")
$ n "18(5,8)"
|- n "<0!2 [0 7] [10 0]>"
# "gtsk"
-- # cut "{0!6 1}%10"
# cut 1
|* speed "{1!14 2 -2}%4"
# shape 0.4
# gain "{1.3!4 1.4 1.1}%7"
# legato 0.9
# accelerate "{-0.8 0}%9"

d1
-- $ (~>) 0.15
-- $ iter 4
$ hurry "1 2 0.5 1"
-- $ hurry "1 1 2 0.5"
-- $ palindrome
$ jux rev
$ sometimes (echoWith 2 "3%8" ((|* speed 0.9) . (|+ n "<0 54>")))
$ n "1 1 [~ 3] 1"
# "gwfk"
# gain "{1 0 1 1.2}%5"
|* gain 1.3
# shape 0.3
# cut 1
# legato 0.9
