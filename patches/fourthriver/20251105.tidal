  $ stutWith 3 "e" (|+ n "<4 0>")
  $ n "0 5 9 1"
  # s "ttml"
  # legato 0.2
  # vowel "{e i a}%5.5"
  # speed "{1 0.5 2}%5"

once $ s "olooper" # recordSource "out" # orbit 2

d3  
  -- $ slice 16 ("4*16")
  -- $ jux (rev . hurry 0.5)
