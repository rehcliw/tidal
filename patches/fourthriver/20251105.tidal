    # delayfb 0.7
    # lock 1

  d7
    $ jux (rev . (|* speed "-2"))
    -- $ slow 2
    $ stutWith 3 "5%8" (|+ n 2)
    $ n "{~ 19 9 2}%8"
    # s "ttp"
    # legato 1
