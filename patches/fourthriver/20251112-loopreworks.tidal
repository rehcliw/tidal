do
  setbpm 140
  d1
    $ degradeBy "0 1 1 1"
    -- $ sometimes (|* speed 2)
    $ juxBy (range "-0.5" 0.5 $ slow 4 $ sine) (rev . hurry "2 0.5")
    -- $ iter 4
    -- $ hurry 0.5
    -- $ echoWith 3 "e" (|* speed "-1")
    $ sometimes (bite 16 (struct "t*32" (slow 3 $ run 16)))
    $ sometimes (plyWith 8 ((|* gain 0.9) . (|* legato 0.9) . (|* speed 1.1)))
    $ hurry "{1 2 1 0.5 2}%6"
    $ strat' "{8 4 16 2}%5" "{4 2 16}%4"
    $ n "<[0 1 4 3]>"
    # "4rloop"
    # cut "{1 0 2 1}%3"
