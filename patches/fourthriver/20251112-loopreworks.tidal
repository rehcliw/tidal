    # "4rloop"
    # cut 1
    # legato 0.8
    # speedTake "s" [1,2,1,0.5]
    # verb 1 0.1 0.9 "{0.1 0.9}%5"
    # fshift "50 0 -5"
    
  d3
    $ degradeBy "0 0 0 1"
    $ chat' "{4 16 32}%4" "16 4 32"
    $ n 6
