    # legato "{1 2 1 2}%5.5"
    -- # delay "{0.5 0 0 0 0}%8"
    -- # delayt "1%64"
    -- # delayfb 0.8
    -- # lock 1

  d2
    -- $ fast 2
    -- $ slow 2
    $ degradeBy "1 0 1 0"
    $ chunk 4 (fast 2)
    $ n (runmod "{32 16 4}%4" "{2 4 2}%2" "4 9")
