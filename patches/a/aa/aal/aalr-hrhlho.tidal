do
  -- let pat = "1([9 7 5]/2,16,<1 0 2>)"
  let pat = "1([9 7 5]/2,<18!4 16>,<1 0 2>)"
  d1
    -- $ hurry 0.5
    -- $ euclid 
    $ mask pat
    $ n "21*12"
    # sTake "s" ["hrhlhok","hrhlhok", "hrhlhokc","hrhlhok"]
    # shape 0.4
    # cps 0.1 -- transition in with
    -- # cps (135/60/4)
    -- # legato 0.9
    -- # cut 1
  d2
    $ juxBy "-1 1" (fast "{2 1 0.5}%4")
    $ mask (inv pat)
    $ "1*6"
    # "hrhlhoc"
    # n "{1!7 3 7 8}%9"
    # cut "{2 1 0}%5"
  d3
    -- $ hurry 0.5
    $ mask pat
    $ "1*18"
    # "hrhlhohh"
    # n "{0 1!5}%8"
    # bpf (range 3500 9500 $ fast 1.5 $ saw)
    # bpq 0.2
    -- # cut 1
  d4
    $ juxBy (range "-1" 1 $ sine) (rev . hurry 0.5)
    -- $ degrade
    $ echoWith 3 "<1%3 5%12>" (|* note "{12 5 -7}%6")
    $ "hrhlhosfx"
    # n "{5 2 7}%8"
  d5
    $ n "{3 0 1 6 2 5}%5"
    # "readorb"
    # delay' 1 (smooth $ "{0.01 0.03 0.02}%4") 0.9
    # ring 2
    # ringf "{200 1500 500 5500 400}%4"
    # ringdf 4
  d6
    $ slow 2
    $ n "{-1 _ _ -3 _ <0 _>}%9"
    # "super808"
    # voice "{0.1 2 1 4}%7"
    # rate (range 0.15 1 $ slow 3.4 $ sine)
    # shape 0.4
  d7
    $ n "{4 0 1 2 5}%7"
    # "readorb"
    # room 1
    # sz 0.9
    -- $ clouds

  

once $ "hrhlhosfx" # n 2