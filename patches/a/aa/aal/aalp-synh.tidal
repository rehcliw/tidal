$ drumM "rolandtr808" [
  weave 5 (
    (pan sine) 
    # (ringf (
        segment 5 
        $ range 50 800 
        $ (saw * (fast 2.3 $ sine))
        )
      )
    ) [
    slow "{1 2}%3" $ "bd:1(3,8,0)" 
    # acc "-1" 
    -- # squiz 2 
    -- # fshift 50
    -- # gain 1.5
