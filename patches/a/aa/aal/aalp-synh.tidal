    # (ringf (
        segment 5 
        $ range 30 800 
        $ (saw * (fast 2.3 $ sine))
        )
      )
    ) 
    -- stack
    [
    slow "{1 2}%3" 
    $ rarely (ply 2)
    $ "bd:1(3,8,0)" 
    # acc "-1" 
    # gain 1.4
    , "sd:1*4" 
    # bpf "{2500 5500}%5" 
    # bpq 5
    , "[~ cb]" 
    , "hh([9 7 13]/2,16,<1 0>)" 
    # gain 0.9 
    # bpf "{1500 2500}%5" 
    # bpq 5
  ] 
  # ring 1 
  # ringdf 20 
