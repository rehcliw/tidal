    , "hh(9,16)" # gain 0.9 # bpf "{1500 2500}%5" # bpq 5
    , "cb" 
  ] 
  # ring 1 # ringdf 20
] # shape 0.8
-- # acc 0.5

once $ "rlooper" # recordSource "out" # orbit 1


