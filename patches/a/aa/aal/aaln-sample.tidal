-- serge, that other one...
do
  d1
    -- $ juxBy 0.3 (hurry 0.97)
    $ repeatCycles 16
    -- $ hurry 0.4
    $ bite 8 "1*2"
    $ often (juxBy (range "-1" 1 $ slow 6.5 $ sine) (rev . (# cut "<2 [1 0 2] 2>") . hurry "{4 1.04 0.7}%13"))
    $ slow "<8!3 1>"
    $ echoWith "{1 0 0 0 2 0 0}%1.5" "<0 e>" (|* speed 1.05)
    $ fast "{5 0.1 0.4 12}%3"
    $ slice "<54 101 8>" ("{5 1 0 3 7 9 11}%9" * "{8 4 7 1!2 0 2}%5" + "{2 0 1}%10")
    $ "serge"
    # speed "{2.02 1 0.1 0.97 4.3}"
    # cut "<1 0>" 
    # legato 1
    # accelerate "<0!4 [0 1 0 0] [-2 0 0 0]>"
    |* gain 0.8
    -- # room "0.3 0"
    -- # sz 0.2

d2 
$ slow 1.4
$ "rlooper"
# recordSource "out"
# orbit 0

d3
-- $ slow "{4 1 8 0.3}%5"
-- $ (|* speed (range 0.2 2 $ slow 3.4 $ sine))
$ echoWith 2 0 (chop (slow 4 $ "{100 120}%5" - "0 2 -8") . (|* gain 0.8))
$ juxBy 0.3 (hurry 0.97)
$ hurry 0.5
$ "loop"
# legato 1.3
# speed "-1"
-- # cut 1
-- # att 0.02
-- # rel 6
-- # room 0.3
-- # sz 0.5
-- # ringsfreq "{[100,150] _ <[690,600] ~>}%3"
-- |* ringsfreq 0.5
-- # ringsstruct "<0.1 0 0.2>"
-- # ringsbright "1 0.9"
-- # ringsdamp "<0.3 [0.3 0.5] 0.1>"
-- # ringspos (range 0 1 $ slow 4.3 $ perlin)
-- -- # ringspos 0
-- # ringsmodel 1
-- # ringspoly 1
# gain 1.3

d4
$ slow 4
$ n "2"
# legato 1.2
# "readorb"
# coarse 4
-- # att 0.2
-- # rel 6
# gain 1.5
# shape 0.5
# room 0.9
# sz 0.9