d1
-- xfadeIn 1 8
$ juxBy (range 1 "-1" $ slow 3 $ sine) (hurry "{0.5 1.03 0.97 1.02}%3")
$ slow "4"
$ note (
  scale "lydian" 
  $ echoWith 6 "<[3%8 e] [7%16 11%9]>" (|+ "<2 -3 3 1 -3>") 
  $ "<[c2 bs f1 g4] [b2 as3 c4]>" - 10
)
