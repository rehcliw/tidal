d1
-- $ hurry "{2 1!4 0.5 1!3}%4"
$ hurry "3"
$ drumM "emumodular" [
  fix (echoWith 2 "q" (|* speed 2) . hurry 0.5 . (# lpf 1500)) (s "perc")
  $ fix ((# ring 1) . (# ringf 300)) (s "misc")
  $ "<bd bd:1> misc <{perc perc:1 perc}%4 bd perc> misc"
  # speed "{1 2 0.5}%8"
  |* speed (smooth $ "{0.95 1.05 0.5}%0.4")
  # acc "<1 0!5 -1 0!3 -2 0!4>"
] 
# cut "{1 0}%3"
# shape 0.5
# cps (140/60/4)
-- # cut 1

d2
