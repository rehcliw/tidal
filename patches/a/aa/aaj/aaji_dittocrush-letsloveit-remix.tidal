d1
$ hurry 0.5
$ juxBy (range 0 0.5 $ slow 1.25 $ sine) rev
$ sometimes (|+ n 6)
$ stutWith 8 "<t 0>" (|* speed "<-0.9 1.1>")
$ striate "4 8 16"
$ s "lli"
# legato 1.1
# att 1.3
# rel 8
# nTake "nt" [0,1,2,3,4]
# shape 0.4
# accelerate "-0.1"
# gain 1.1
# clouds (range 0 1 $ slow 3.4 $ sine) 0.9 0.3 0.4
