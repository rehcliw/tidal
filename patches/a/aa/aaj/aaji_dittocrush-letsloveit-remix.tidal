once $ s "freeLoops"

-- usually glitchy stuttery low
-- xfadeIn 2 4
d2
$ stutWith 8 "1%16 1%32" ((|* gain 0.9) . (|* speed 1.5))
$ (# legatoTake "l" [0.1,0.3,0.05])
$ struct "t(<3 5>,8,<0 1 2 3>)"
