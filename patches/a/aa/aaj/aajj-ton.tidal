d1
$ juxBy ("{-0.5 0.5}%7" * "{0.3 1 1.8 0}%5") (rev . hurry 0.9)
$ stutWith 4 "1%32 e" (|* speed "-1.1")
$ hurry "{0.9!2 1.8 0.45}%3"
$ hurry 0.25
$ rarely (# vowel "o")
$ slice "{8 34 5 9 15}%3" ("{5 2 1 0 20 25}%5" + "12 5 0 -3")
$ s "{nimbl:2 nimbl:1}%7"
# legato 1.1
# gain "{1.6 1 1.3 1.7 0.5}%9"
# shape 0.7
# crush "{16 2 4 3 5}%3"
# cut "{1 0}%3"
# att "0.1 0"
# rel "{8 0.1}%5.4"
# accelerate "0 0.2 -0.1"
-- # distortbus 0 (range 0.25 0.9 $ saw * (fast 1.25 $ sine))
-- # speed "[1,1.01,0.98]"
# cps 0.6

-- turn combL on in cross-orbit-routing
d2
$ n "{0 2 3}%4"
# legato 1
# s "readorb"
# lpfbus 1 "10000 100 500 2500"
# lpqbus 2 "{0.3 0.2}%7"
# distort 0.9
# squiz 4

d3
$ n "1 4"
# s "readorb"
# legato 1.1
# delaybus 3 "1 1"
# delayt "0.3"
# delayfb 0.9
# lock 1

once $ s "olooper:1"

once $ s "freeLoops"

d4
$ chunk 3 (hurry 2)
-- $ hurry 0.15
$ striate' "{16 32 8}%5" 0.1
$ s "loop:1 loop:0"
# legato 1
# gain 1.4
# shape 0.5
# speedTake "s" [-0.5,1,-2]

d5
$ sometimes ((# coarse 4) . (# lpfbus 0 (range 50 2500 $ slow 3.1 $ sine)
) . (# lpq 0.2) . (# distort 0.3))
-- $ palindrome
$ echoWith 8 "s 1%54" ((|* gain 0.9) . (|* speed "-0.8 1.2"))
$ bite 4 "<[0 1 2 3]!3 0*8 3*16 1>"
$ hurry 0.125
$ degrade
$ rot "{1 0}%6.7"
$ juxBy (range "-0.5" 0.5 $ perlin) (rev . hurry 0.5)
$ n ("[0 9 ~]/1.3 7 [19 11]*<1 7 0.5> 14" + "<0!2 13 1>")
