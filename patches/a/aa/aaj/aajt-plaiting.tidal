

scaleList


do
  
  let pat = "{1 1 1 0 1 1 0 1}%5"

  d1
    -- $ jux (rev . hurry 0.5)
    -- $ chunk 4 (hurry 2)
    $ echoWith 4 "{e}%5" ((|* harm 0.9) . (|* gain 0.9) . (|* timbre 0.9))
    $ every 4 (mask (inv pat))
    $ note (scale "spanish" $ runmod 16 "<2 3 4>" "{0 4}%3" |- "{7 0 -7}%5")
