d5
-- $ bite 16 ("0*16")
$ juxBy 0.5 (rev . hurry 2)
-- $ every 4 (slow 2 . (# morph 0.4))
$ hurry "{1 1 2 1 0.5}%3"
$ note (scale "spanish" $ sometimes (echoWith 4 "1%4" (|+ "<-4 4>")) $ "{1 _ _ 1 [-7 7] _ 45}%16")
