once $ s "olooper" # n 1

d4
$ juxBy (range "-1" 1 $ perlin) (rev . hurry 2)
$ stutWith 3 "q" (|* speed 0.5)
$ sometimes (# hpf "{1000 5500 1900 9500 500}%7.6")
