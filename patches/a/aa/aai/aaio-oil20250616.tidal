d1
$ stack [id
  $ degradeBy 0.5
  $ slow 8
  $ juxBy "-0.5 0.5" (rev . fast "{0.5 1}%5")
  $ freq (segment "{2 1}%5" $ quantise (1/50) $ rangex 25 5500 $ rand)
  -- $ freq "500*16"
  # s "pmsin"
  # gain 0.5
  # legato 1
  # att 0.1
  -- # rel 1.5
  # rel 6
  -- # cut 1
  , id
  $ degradeBy 0
  -- $ jux rev
  $ sometimes (plyWith 4 (|* gain 0.9) . (|+ n 14))
  $ struct "t(<5 7 9>,16)"
  $ n "{-29 -22.5 -40}%4"
  -- $ n "0"
  # s "super808"
  # distortbus 2 (range 0 0.2 $ fast 3.23 $ saw)
  -- $ s "super808"
  -- # n "0"
  -- # rate 0.2
  # rate "{0.9 0.2}%5.1"
  # voice "{0.9 0.1 0.5}%7"
  , id
  $ degradeBy 0.3
  $ ply "<2 1>"
  $ mask "{0 1 0 1 1}%3"
  $ s "gtsh*32"
  # accelerateTake "a" [-2,0,-1,0,0,1,2]
  # legato "{0.5 1}%7"
  # panTake "p" [0,1]
]
|* gain 0.7
# cps "0.2 0.1"

d1 silence

d2
$ s "{0 3 2}%4"
