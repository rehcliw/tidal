do
  let cslices = "{16 32 8 2}%3"
  -- let cslices = ""
  let pslices = "32"
  d1
    -- $ fast 0.5
    $ hurry 0.25
    $ degradeBy 1
    $ juxBy (range "-1" 1 $ slow 1.2 $ sine) (rev . hurry "{0.5 2}%0.5")
    -- $ repeatCycles 8
    $ slice cslices (segment cslices $ irand cslices)
    $ "contact"
    # legato 1
    # gain 1
    # speed "{0.5 [1,<1.05 1.01 2>] 2}%3"
    # shape 0.9
    # crush 2
    # distort 0.9
    -- # delay' "{0.5 0 0.2}%2" (smooth $ "{0.02 0.004 0.03}%3.1") 0.9
    -- # pan "-1"
  d2
    -- $ degradeBy 0.9
    -- $ fast 0.5
    $ hurry 0.25
    $ juxBy (range "-1" 1 $ slow 1.1 $ perlin) (rev . hurry "{0.5 0.25}%5")
    $ slice pslices (segment pslices $ irand pslices)
    $ "plastic:2 plastic:0"
    # legato 1
    # shape 0.8
    # gain 1.4
    # speed "{0.25 2 1 0.5}%5"
    -- # squiz 8
    -- # accelerate "0.5 0.1 -1"
    -- # gain 0
  d3
    $ degradeBy 1
    $ slice pslices (segment pslices $ irand pslices)
    $ "jjbreaks:2"
    # gain (range 0.5 1 $ fast 2.5 $ sine)
    # shape 0.4
    -- # speed 0.5
    # legato 1.2
    # delay' "{0.5 0 0.2}%2" (smooth $ "{0.2 0.04 0.3}%3.1") 0.9
    # gain 1
  d4
    -- $ degradeBy 0.5
    $ hurry "{1 0.5 0.2 2}%7"
    $ n "{[0,1,2] 4}%9"
    # "readorb"
    -- # lpfbus 0 (range 500 9500 $ slow 2.3 $ sine)
    -- # lpq "0.9 0"
    # fshift "-500 50 500 -50"
    # shape 0.4
  d5
    -- $ degradeBy 0.4
    $ n "3*4"
    # "readorb"
    # legato 1.1
    -- # delay' "{0.5 0 0.2}%2" (smooth $ "{0.02 0.004 0.03}%3.1") 0.9
    -- # ring 2
    -- # ringfbus 3 (range 500 9500 $ slow 1.4 $ sine)
    -- # verb 0.9 0.9 "0.3" 0.8
    -- # ringdf 0.12
    # shape 0.9

d7 
$ loopAt 4
$ "looper"
# n "0"

d6
-- $ slow 4
$ hurry 0.25
-- $ juxBy "{-1 1 0.5}%4" (rev . hurry (segment 8 $ range 0.25 4 $ fast 1.5 $ sine))
-- $ degrade
-- $ striate 32
$ "loop"
# legato 0.8
# gain 0.9
# speed 1
# legato 1
# accelerate "-1"


--- section 2
d1
$ juxBy (range "-0.5" 0.5 $ perlin) (rev . (|* speed "-1") . fast 0.5)
$ stutWith 3 "0 e" (|* speed 0.5)
$ striate "8 4 4 16"
-- $ slice pslices (segment pslices $ irand pslices)
$ "jjfx:14"
# legato 1
# coarse 4
# speed 0.5
-- # accelerate "{2 -2 1 -1 0}%4"

d4
-- xfadeIn 4 4
  $ n "[0,1,2,4]*4"
  # "readorb"
  # legato 1.1
  # bpfbus 0 (range 50 9500 $ slow 1.9 $ sine)
  # bpq 1

d5
  $ n "3*4"
  # "readorb"
  # legato 0.9
  # ringbus 2 1
  # ringfbus 1 (range "-50" 500 $ slow 1.8 $ sine)
  -- # verb 0.9 0.9 "0.1" 0.8

d6
  $ n "4"
  # "readorb"
  # legato 0.9
  # delay' 1 "1%3" 0.9
  # lock 1


-- looping
d7 
$ loopAt 4
$ "looper"
# n "0"


-- clutchIn 1 8
d6
-- $ juxBy "{-1 1 0.5}%4" (rev . hurry (segment 8 $ range 0.25 4 $ fast 1.5 $ sine))
-- $ degrade
-- $ striate 32
$ "loop"
# legato 0.2
# gain 0.7
# speed 1
# legato 1
-- # accelerate "1"

d1
-- $ hurry "0.25"
$ jux (rev . hurry "0.5 2")
-- $ iter 4
$ slicemod 16 "5" "<6 2>"
$ "nimbl:2"
-- # speed 0.5
# legato 1
-- # speed 0.25
# accelerate "-0.4"
-- # delay' 1 "0.3" 0.9