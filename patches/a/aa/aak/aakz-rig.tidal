setbpm 138

d1
$ hurry "0.25 2"
$ jux (rev . hurry 0.5)
$ slicemod 32 "5 2 5" "{0 16 4 19 25}%4"
$ "rig"
# legato 0.5
# speed 0.5
# gain 1.2

d2 
$ slow 2
$ sometimes (echoWith 2 "e" (|* speed 2))
$ n "0(5,16)"
# "houk"
# lpf 500
# delay' 1 "2%3" 0.9

d3
$ "rlooper"

d4
$ hurry 0.5
$ jux rev
$ chunk 4 (hurry "2 0.5")
$ striate "4 8 16"
$ "loop"
# speed "{2 0.5 0.25}%7"
# accelerate "{-1 1 0}2"
# legato 0.5
# shape 0.2
# gain 1.3
# delay' 1 "1%9" 0.2



