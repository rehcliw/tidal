# shape 0.4
# gain 1.2
# mu 3
# legato 1
-- |/ speed 2
# accelerate "-1"

d4
-- $ repeatCycles 2
$ (<~) "0.5 -0.5"
$ jux (rev . hurry 0.5)
$ mask "{1 0 1 1 0 0 1}%18"
$ n "8*18"
