do
  setbpm 140
  let freqfoldhi = pF "freqfoldhi" 
      sigfoldhi = pF "sigfoldhi"
      mstart = pF "mstart"
      astart = pF "astart"
  d1
    -- $ chunk 4 (hurry "<0.5 2>")
    $ echoWith 4 "1%18" ((|* freqfoldhi "{0.5 1 2}%5") . (|* freq "<2 1>"))
    $ "1(<3 5>,9)"
    -- # n "4 12"
    # freq "900 450"
    # "foldy"
    # rel "{3 0.01 1}%5"
    -- # rel 0.3
    -- # legato "<0.2!2 1 1.2 0.9>"
    # freqfoldhi "{2000 500 9000 50}%3"
    # sigfoldhi "1 10 140"
    # mstart "{0 3 9 80}%2"
    # astart 30
    # lock 1
    # delay' "{1 0 0.5}%7" "{1%64 1%65 1%128}%4" 0.8

once 
$ s "rlooper"
# recordSource "out"
# orbit 1

once $ "freeLoops"

d2
-- $ hurry 4
-- $ degradeBy 0.5
$ (<~) "0.5 -0.5"
-- $ slice 16 (runmod 16 "3 5" "{0 4 13}%4")
$ splice 18 (runmod "18 9 36" "{3 5 1}%5" "{9 0}%7")
$ "loop"
# gain 1.2
# speed "{1 2 1 1.25 -0.5}%3"
# legato "{0.1 0.3 0.6}%5"
