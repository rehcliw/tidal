-- # coarse 4
-- # lock 1
-- # delay' "{1 0 0.5}%7" "{1%64 1%65 1%128}%4" 0.8
-- # delay 1
-- |* delayt "<100 50>"

d3
-- $ slow 2
$ n "5(<5 4>,9,<1 0 0 1 2>)"
