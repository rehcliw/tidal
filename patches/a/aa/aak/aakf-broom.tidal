-- current
do
  setbpm 120
  d1
    $ degradeBy 0.2
    $ hurry 8
    -- $ juxBy "{-0.5 0.5}%5" (rev . hurry "2 0.5")
    -- $ sometimes (plyWith "{1 4 8}%5" ((|* gain 0.9) . (|* speed 1.1)))
    $ echoWith 2 "5%8" (|* speed 0.5)
    -- $ slow 4
    -- $ bite 32 "15 19"
    -- $ sometimes (bite 16 "4*8")
    $ slicemod "{32 16 3}%5" "3 5 1" "<16 10>"
    -- $ slat' "16 32 4" "{2 4}%5"
    -- $ striate 32
    -- $ slat' 16 "30"
    $ "nupgl:2"
    # legato 1
    # cut "{1 2 0}%5"
    |* speed "[0.5,{0.503 0.501 0.505}%5]"
    # accelerate "{-1 0}%7"
    # mu "1.4 0.3 2"
    # clouds "{1 0 0.5}%7" 0.2 0.3 0.9
    # cloudsblend 1 0.2 0.4 "{0.9 0 0.5}%6"

  d2
    $ hurry 0.5
    $ rarely (bite 8 "0*6")
    $ repeatCycles 4
    -- $ degradeBy 0.3
    $ echoWith 2 "e" (id
        . bitemod "{32 16 3}%5" "3 5 1" "<16 10>"
        . (# bpfbus 0 (range 50 9500 $ slow 1.5 $ saw)) 
        . (# bpf 4) 
        . (# fshift "0 500 -1500 50")
        . (# delay' "{1 0 0.5}%7" "{1%64 1%4 1%32}%5" 0.8)
        . (# lock 1)
    )
    $ slat' 16 "3"
    $ n "5"
    # "ttdl"
    # legato 1
    # shape 0.4
    # mu 2.4

  d3
    $ degradeBy 0.2
    $ hurry 0.5
    $ "loop"
    # gain 0.9
    # shape 0.3
    # speed 0.5
    # mu 1.5
    -- # coarse 2
    # legato 0.9

  d4
    -- $ degradeBy 0.3
    $ n "{0 1 2 4}%5"
    # "readorb"
    # legato "{1.1 0.5}%5"
    # ring 1
    # ringf "{100 50 200}%5"
    # ringdf 1
    # delay' 0.6 "0.03 1%3" 0.8
    # lock 1

  d5
    $ degradeBy 0.3
    $ hurry 0.25
    $ splice 16 (runmod 16 "3 5" "{0 4 11}%3")
    $ "loop"
    # n 1
    # legato 1
    # mu 2.2
    # speed "{1 2 0.5 -1}%3"
  
once $ "rlooper" # n "1"

d1
$ "loop"
# mu 3

d2

