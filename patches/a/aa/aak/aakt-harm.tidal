-- expensive! 
-- d1
xfadeIn 1 8
$ juxBy (range "-0.5" 0.5 $ perlin) ((|* freq 1.2) . slow 1.3)
$ slow "{8 7 9 10}%3"
$ echoWith 3 "0" ((|+ freq "<5 4 3 6>") . (|* harm "<1.1 0.9 0.95>") . (|* timbre "<1.05 1.1 0.5 0.95>"))
$ freq "30 32 76"
