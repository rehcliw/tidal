d3
$ hurry "{8 2 0.5}%5"
-- $ striateBy 128 0.03
$ juxBy (range "-1" 1 $ perlin) rev
-- $ degradeBy 0.9
$ sometimes (plyWith 2 (|* speed "19%12"))
$ n "<5 25>(5,9,<1 0 2>)"
-- $ n "<5>(3,9,<1 0 2>)"
