d5 $ slow 4 $ "rlooper"

d4
-- $ hurry 0.01
$ juxBy "0.5 -0.5" (rev . hurry "2 0.5")
-- $ degradeBy 0.3
$ hurry "{8 2 0.5 1}%7"
$ euclid "3 5" "8"
$ sometimes (plyWith 4 (|* gain 0.9))
$ slice 16 (runmod 16 "3 5" "{0 4 8}%5")
$ "loop"
