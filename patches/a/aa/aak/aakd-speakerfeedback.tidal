-- outsidify-style mic & speaker feedback
-- impulse generation
d1
-- clutchIn 1 4
-- $ hurry 0.1
$ degradeBy 0.7
$ juxBy "0.5 -0.5" (rev . hurry "0.25 0.5 2 4")
$ slow "{3 1 2}%6"
$ n "0(13,18,<1 0 2>)"
# "imp"
# nTake "n" [0,2,19,500,-5]
# legato "0.01 0.7"
# gain 2
# shape 0.7
|* speed "[1,1.02]"
# accelerate "{0 -3}%6"

d2
$ slow 4
-- $ juxBy 0.5 rev
-- $ degradeBy 0.7
