-- aajp - cute! 
setbpm 84

d3
  $ hurry "2 1"
  -- $ jux (rev . hurry "0.5 2")
  $ (|* speed "<[1 -2 1 1] 1!7>")
  $ every 2 (echoWith 2 "<q e!6>" (|* speed "2"))
  $ slat' "{32 16}%3" "{2 4 1}%4"
  $ "1"
  # "ttdl"
  # legato 1
  |* speed "1"
  -- # gain 1.5
  # gain 1.1
  -- # shape 0.2
  -- # gain "1 0 1"

xfadeIn 2 $ silence

d2
-- xfadeIn 2 4
  -- $ hurry 0.5
  $ juxBy "0.5 -0.5" (rev . (# cut 2) . hurry 2) 
  -- $ degrade
  $ slice 32 (slow "2" $ runmod 32 "{7 2 3 1}%5" "13 0 3 5") 
  $ "ttml:4" 
  # cut 1 
  # gain 1.1
  # shape 0.3



