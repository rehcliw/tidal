-- aafk - kinda airy
d1
$ juxBy 0.5 rev
$ hurry "{0.5 2 0.25 4}%6"
$ every 2 (# freq (fast 0.2 $ quantise 0.05 $ rangex 20 6000 $ perlin))
-- $ repeatCycles 8
$ striateBy "32" (fast 0.9 $ range 0.01 0.1 $ sine)
$ n "{39 <5*2 4> 2}%1.3"
# s "presp"
# att (fast 1.5 $ range 0 0.01 $ sine)
# rel 1
# accelerate "2"
# gain 1.3
# shape 0.5
# clouds (slow 2.6 $ range 0 0.5 $ sine) 0.9 (range 0.6 0.8 $ sine) 0.1
# cloudsblend 0.9 0.2 0.7 0.3
# cps (range 0.3 0.7 $ sine)



