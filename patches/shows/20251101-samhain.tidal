-- aade | spooky bass harmonics
-- xfadeIn 4 8
d5
$ rot "<1 0 2 0>"
$ jux (rev . (|* n 3))
$ fast ("<1 1.01>")
$ striateBy "4 <2 8>" "0.9 0.8 0.01"
$ speed "[[1,1.25] [1.05,3.13] [3.08,1.08] [5.97,9.76909090909]]"
# n "[[~~~2] 0 <9*2 15> 5*2 4/2]"
# s "flbass"
# coarse (fast "0.9" $ range 2 6 $ sine)
# lpfbus 0 (fast (range 0.5 1.2 $ sine) $ range 1000 6000 $ sine)
# attackbus 1 (fast (range 0.5 1.2 $ tri) $ range 0.01 0.9 $ sine)
# sustain 4
# rel 4
# room 0.2
# sz 0.7
-- # legato 1


