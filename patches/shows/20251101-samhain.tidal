-- aajh | doublemix for jams

d1
$ hurry 0.5
$ juxBy (range 0.5 "-0.5" $ perlin) (rev . (# accelerate "1 0") . hurry "0.5")
$ s "inr*3 gtsk:17"
# accelerate "-0.8"
# distort 0.4
# crush 2

d5 $ s "olooper" # n "<0 1 2 3>"

d5 silence

once $ s "freeLoops"

d2
$ hurry 0.25
$ juxBy (range 1 "-0.5" $ fast 1.1 $ perlin) (rev . hurry "{2 0.5 4}%5")
$ stack [id
  $ degradeBy 0.6
  $ chunk 4 (hurry 0.5)
  -- $ hurry "0.125 2 1"
  $ sometimesBy 0.4 (# speed "{0.5 -0.25 1}%5")
  -- $ sometimes (stutWith 4 "1%3" ((|* gain 0.9) . (|* legato 0.9) . (|* speed "{1.5 0.25 1 2}%2")))
  $ every 4 (# accelerate "0 -3 0.1 -0.3")
  $ striateBy 16 "0.1"
  $ s "loop*1 <bndloop:3 bndloop:1>"
  # n "<{0 1 2 3}%3 {1 2 0 3}%7>"
  # legato "0.5 1.5 1.1"
  -- # att 0.3
  -- # relbus 1 "{1 0.3 4}%6"
  # shape 0.5
  # lpf 7500
  # lpq 0.5
  , id
  $ sometimes (plyWith 4 ((|* gain 0.9) . (|* legato 0.9) . (|* speed "{1.1 0.25 0.9}%2")))
  $ s "gtsp*4? gtsk/4"
  # nTake "nt" [18,0,5,15]
  # legato 1
  # shape 0.9
  # coarse 2
  # speed "-0.5 1"
  # lpf 1500
]
# cps (range 0.2 0.6 $ saw)
-- # coarse 4

d3
$ s "{[readorb,readorb:1] readorb:3}%1.35"
# legato 1.1
# clouds (range 0 1 $ slow 3 $ sine) 0.2 0.8 0.3
# cloudsblend "{0.8 0 0.4}%7" 0.9 "{0.5 0}%3" "0.1 0.9 0.3 0.5"
# cloudsfreeze "0 1 0"
# fshiftbus 4 (segment 32 $ range 50 "-500" $ slow 1.4 $ sine)

d4
$ s "{readorb:1 readorb:2 readorb}%3.5"
# legato 1.1
# delay 1
# delayt "0.03 0.3 0.01 0.02 0.9"
-- # delayt 0.4
# delayfb (range 0.9 0.5 $ slow 3.1 $ sine)
# bpfbus 0 (sometimes (smooth) $ "{400 40 8500 500}%2")
# bpq 2