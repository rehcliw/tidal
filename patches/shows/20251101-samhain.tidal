once $ s "numbers"

-- aadn | noisy, lurching...
d3
$ stack [id
$ hurry "[0.5 0.25]/3 1/2 0.125/4"
$ (# cut "{1 0 2 3 0 4 3}%2")
$ spreadf [(|* speed "{1.3 2 2.5 [0.7 1] 3}%2"), (|+ n "{3 4 0}%4"), (rev . (slow 4))]
$ every 2 (juxBy 0.8 rev)
$ degradeBy 0.2
$ (# gain 0.8)
$ (# speed 0.5)
$ ((# room "{0.1 0 0.2}%7") . (# size "0.8 0"))
$ ((# attack "{0.1 0 0.2 0.05}%5") . (# rel "5") . (# coarse "4 1") . (# lpf "{1000 2900 1400}%4"))
$ sound
$ step' ["nimb:27", "nimb:9", "nimb:13", "nimb:39"]
  (take 512
    $ lindenmayer 5 "0:1~2~3~,1:0~~~2~2~~0~~~2~,2:2~1~,~:~~1~,3:~1~0~~~2~3"
  "1 1 0 1"
  )
-- , id
-- $ n "1*5"
-- # s "nimb"
]

--------------

-- aadk | roomy percussion.. cool to move lines around and loop
d4
-- $ fast 2
$ juxBy "<0.5 -0.5>" (rev)
$ every 2 (bite 8 (struct "t(7,16,<0 1 2>)" "{0 1 2 3}%3"))
-- $ repeatCycles 4
$ rot "<1 0 0 2 1 0>"
$ fast "{1%2 1 3%4}%5"
$ stutWith 2 "<0 0.25>" (|+ n "1")
$ chunk 4 (hurry "1%2")
$ rarely (striateBy 16 "{0.3 0.2 0.1}%4")
$ whenmod 5 2 (|* speed "[[4%5 4%3]|[3%4 6%5]]")
$ whenmod 6 3 ((# n "{~ 1 ~ 1}%5") . (|+ n "{~ 2 5}%5"))
$ whenmod 5 4 (id
  . (# delay 0.5)
  . (# delayt "<1%8 1>")
  . (# delayfb 0.6)
  . (# lock 1)
  )
$ n "0 2 6 10"
# s "vscodarbuka/2 vscostuff/4 vscoothdrum/3"
# cut "{1 0 3 2}%6"
-- # cut "<1 0 2>*1.5"
# comb 0.1
# shape 0.5
-- # lpf "1000"
# attack "0.01/3 0.04/4 0.5/3"
# rel 3
# decay 0.8
# gain 1.5
# room 0.2
# sz 0.7

setcps 0.7

once $ s "freeLoops"

d1
$ slow 4
$ s "rlooper"
# recordSource "out"
# orbit 3

once $ s "freeLoops"

d2
$ s "loop"
# gain 1.9
# coarse 4
# speed "0.5"
# legato 2

