$ echoWith 2 "1%2" (
  (|* ringsfreq "<0.75 0.5!2 2>") 
  . (|+ ringsstruct "{0.6 0}%1.1") 
  . (# delay' 0.8 "5%16" 0.8) 
  . (# lock 1)
