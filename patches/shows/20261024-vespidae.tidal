-- synh
d1
$ juxBy (range "-0.5" 0.5 $ sine) (rev . hurry 0.5)
$ weaveWith 3 (id
  $ n (id
    $ scale "mixolydian" 
    $ echoWith 2 "1%4" ((|+ "<7 -7>")) 
    $ "0(<3 5>,16)"
    )
  # "plaits"
  # engine "12"
  # harm "{0.4 0.5 0.2}%2"
  # morph 0.2
  # timbre "{0.5 0.6 0.4 0}%5"
) [
  plyWith 2 (|* morph 2)
  , hurry 0.5
]
