---aajt plaiting


scaleList


do
  
  let pat = "{1 1 1 0 1 1 0 1}%5"

  d1
    $ jux (rev . hurry 0.5)
    $ chunk 4 (hurry 2)
    $ echoWith 4 "{e}%5" ((|* harm 0.9) . (|* gain 0.9) . (|* timbre 0.9))
    $ every 4 (mask (inv pat))
    $ note (scale "spanish" $ runmod 16 "<2 3 4>" "{0 4}%3" |- "{7 0 -7}%5")
    # "plaits"
    # engine "5"
    # harm (range 0 1 $ sine)
    # timbre (range 0 1 $ slow 1.5 $ sine)
    # morph (range 0 1 $ slow 2.5 $ sine)
    # mode "0 1"
    # level "{1 0.5 0.2}%7.7"
    -- # gain 0.9
    # accelerate "-0.05 -0.1"
    # cps (90/60/4)
    # shape 0.5

  d2  
    $ mask pat
    -- $ echoWith 4 "{e t}%5" ((|* harm 0.9) . (|* gain 0.9) . (|* timbre 0.9))
    $ rarely (ply 2)
    $ "1*8"
    # note (scale "spanish" $ "-29 -22 -15")
