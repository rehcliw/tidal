    # lpgcolour 0.2
    # shape 0.5
    # distort 0.2
    # cut 1
    -- # accelerate "-1"
    -- # cps "0.6 0.3 0.9 0.15"

  d3
    $ jux rev
    $ echoWith 3 "1%32" ((|* timbre 0.9) . (|* gain 0.9))
    $ mask (inv pat)
    $ "1*16"
    # note "-3 7 0"
    # "plaits"
    # engine 14
    # harm "{0 1 0.5}%7"
    # timbre "{1 0 0.5 0.2 0.9}%5"
    # lpgdecay 0.2
    # lpgcolour 0.9
    # cut 2

  d4
    $ mask (pat)
    $ "1*32"
    # "plaits"
    # engine 15
    # harm "{0!3 1}%5"
    # timbre 0.2
    # morph 0.9
    # mode 0
    # cut 3
  
