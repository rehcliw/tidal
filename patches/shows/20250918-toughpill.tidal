-- crosley jam --

d1
$ juxBy (range "-0.5" 0.5 $ perlin) rev
$ sometimesBy 0.2 ((# lpfbus 0 (range 50 9500 $ slow 5.7 $ saw)) . (# lpq "0.3 0.2 0"))
$ sometimes (stutWith 3 "e s" ((|* gain 0.9) . (|* legato 0.9) . (|* speed 1.9)))
$ striate (stutWith 2 "e" (|+ "<0 1>") $ "{16 17 18 9 32}%5" + "<5 0 2 [3 5] [6 7 9]>")
$ s "crosley"
# legato 1
# n "[0,1]"
# speed "{1.1 1 0.9 0.5}%9"
# cut "0 0 0 2 0 1"
-- # room "{0.8 0}%1"
-- # sz 0.9
# verb "{0.8 0}%1" "0.9 0.1" 0.9 0.2
# distort "{0.9 0}%5"
# coarse "{4 0}%7"

d2
$ hurry "0.25 0.3 0.17"
$ chunk 4 (hurry 0.3)
$ slice 8 "{0 1 2 3 4 5 6 7}%5"
-- $ s "{crosley nimbl}%3.3"
$ s "crosley"
# squiz 8
# crush "{3 5 16}%2"
# legato 1.5
# gain 1.4
# shape 0.8
# distort 0.5
|* speed "-1 1"
# accelerate "-0.1"
# att 0.7
# rel 8
# verb 1 "0.9 0.1" 0.9 0.2

-- try to catch the "wail" of the nimb
once $ s "olooper"

once $ s "freeLoops"

d3
$ juxBy 0.5 rev
$ echoWith 3 "e" (|* speed "{1 -2 -1 0.5}%5")
$ s "loop"
# gain 1.8
# speed "-0.5"
# legato 1.2

