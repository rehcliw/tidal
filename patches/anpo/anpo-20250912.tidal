--- 2 ---
once $ s "numbers:1"

d1
$ jux (|* speed "-0.5")
$ hurry 0.5
$ sometimes (slice 16 (run 16))
$ s "bndloop"
# legato 1
# gain 0.7
-- # lpf 1900
-- # lpq 0.1
-- # coarse 3
# cps (139/60/4)

d2
-- $ hurry 0.5
$ jux (rev . hurry "{0.5 1}%3")
$ stutWith 3 "1%16" (|+ n 3)
$ n "{7 3 8}%4"
# s "bnp"
# gain 0.8
# cut 1
# legato 0.2

d3
$ jux (rev . (|* speed "-0.5") . slow 2)
$ s "bnclp:5*2"
# gain 0.9
# legato 0.9
# nudge 0.3

d4
$ hurry 0.5
$ s "bnk:4*3"
# gain 1.1
# legato 1
-- # speed 0.7

d5
$ s "{readorb:0 readorb:1 readorb:5}%4"
# legato 1.1
# vowel "o"
# distort 0.3
# delay "1 0"
# delayt "{1%32 1%8 1%64}%5"
# delayfb 0.8
# lock 1
# verb 0.9 0.7 0.2 0.9

d6
$ hurry 0.25
$ striate 32
$ s "bnpad:15"
# coarse 4
# distort 0.5
# legato 1.1
# verb 0.9 0.7 0.2 0.9

-- 3 --
once $ s "numbers:2"

d1
